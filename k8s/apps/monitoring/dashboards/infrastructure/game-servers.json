{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "type": "text",
      "title": "About",
      "options": {
        "mode": "markdown",
        "content": "Game servers probed by blackbox-exporter on s2, **without WARP**: the path the game would take over the home line (MAP-E for IPv4). Compare with how the game feels on d1, which may run through WARP.\n\n- **FFXIV**: `119.252.37.23` (Gaia), the server the client keeps its connection to on port 54992.\n- **VALORANT** is not probed: match servers change every match, sit in different Riot networks, and answer neither ICMP nor TCP. Use the in-game Stats graphs (Network RTT, packet loss) instead."
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Time to complete the TCP handshake to each game server, every 15 s. A value near 1 s is a lost SYN that the OS retransmitted, the kind of stall that shows up as a hitch in game.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "probe_duration_seconds{job=\"blackbox-exporter\", group=\"game\", check=\"tcp\"} - probe_dns_lookup_time_seconds{job=\"blackbox-exporter\", group=\"game\", check=\"tcp\"}",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "title": "TCP connect time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Round trip time to each game server, every 30 s.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "probe_icmp_duration_seconds{job=\"blackbox-exporter\", group=\"game\", phase=\"rtt\"}",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "title": "ICMP RTT",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Number of TCP connect probes in the past hour that took over 0.5 s, out of 240 an hour (12 is a 5% stall rate).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (target) (count_over_time(((probe_duration_seconds{job=\"blackbox-exporter\", group=\"game\", check=\"tcp\"} - probe_dns_lookup_time_seconds{job=\"blackbox-exporter\", group=\"game\", check=\"tcp\"}) > 0.5)[1h:15s])) or sum by (target) (count_over_time(probe_success{job=\"blackbox-exporter\", group=\"game\", check=\"tcp\"}[1h])) * 0",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "title": "Slow connects per hour (> 0.5 s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of probes in the past hour that failed (timeout or no reply). For ICMP this is the packet loss rate.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (1 - avg_over_time(probe_success{job=\"blackbox-exporter\", group=\"game\"}[1h]))",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "title": "Probe failures per hour (%)",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
    "blackbox-exporter",
    "game"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "Asia/Tokyo",
  "title": "Game Servers",
  "uid": "game-servers"
}
