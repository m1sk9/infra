{
    "tagOwners": {
        "tag:k3s":           ["autogroup:owner"],
        "tag:k3s-server":    ["autogroup:owner"],
        "tag:k3s-agent":     ["autogroup:owner"],
        "tag:observability": ["autogroup:owner"],
        // Only the CI OAuth client may mint this tag.
        "tag:ci":            [],
    },

    "grants": [
        {
            "src": ["autogroup:owner"],
            "dst": ["tag:k3s"],
            "ip":  ["*"],
        },
        {
            "src": ["tag:ci"],
            "dst": ["tag:k3s"],
            "ip":  ["tcp:22"],
        },
        {
            "src": ["autogroup:owner"],
            "dst": ["autogroup:internet"],
            "ip":  ["*"],
        },
        {
            "src": ["tag:k3s"],
            "dst": ["tag:k3s-server"],
            "ip":  ["tcp:6443"],
        },
        // kubelet and flannel open connections in both directions, so neither can be narrowed to one way.
        {
            "src": ["tag:k3s"],
            "dst": ["tag:k3s"],
            "ip":  ["tcp:10250", "udp:8472"],
        },
        {
            "src": ["tag:observability"],
            "dst": ["tag:k3s"],
            "ip":  ["tcp:9100"],
        },
    ],

    "ssh": [
        {
            "action": "accept",
            "src":    ["autogroup:owner", "tag:ci"],
            "dst":    ["tag:k3s"],
            "users":  ["m1sk9"],
        },
    ],

    "tests": [
        {
            "src":    "m1sk9@github",
            "accept": ["tag:k3s:22", "tag:k3s-server:6443"],
        },
        {
            "src":    "tag:ci",
            "accept": ["tag:k3s:22"],
            "deny":   ["tag:k3s:6443", "tag:k3s:10250", "tag:k3s:9100"],
        },
        {
            "src":    "tag:k3s",
            "accept": ["tag:k3s-server:6443", "tag:k3s:10250"],
            "deny":   ["tag:k3s-agent:6443", "tag:k3s:9100", "tag:k3s:22"],
        },
        {
            "src":    "tag:observability",
            "accept": ["tag:k3s:9100"],
        },
    ],
    "sshTests": [
        {
            "src":    "m1sk9@github",
            "dst":    ["tag:k3s"],
            "accept": ["m1sk9"],
            "deny":   ["root"],
        },
        {
            "src":    "tag:ci",
            "dst":    ["tag:k3s"],
            "accept": ["m1sk9"],
            "deny":   ["root"],
        },
    ],

    "nodeAttrs": [
        {
            "target": ["m1sk9@github", "tag:k3s"],
            "attr":   ["nextdns:${NEXTDNS_PROFILE_ID}"],
        },
        {
            "target": ["*"],
            "attr":   ["nextdns:no-device-info"],
        },
    ],
}
