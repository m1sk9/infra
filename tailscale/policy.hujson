{
    // ===== Tag Declaration =====
    "tagOwners": {
        "tag:server-s1": ["autogroup:owner"],
        "tag:server-s2": ["autogroup:owner"],
        "tag:ci":        [],
    },

    // ===== Grants Declaration =====
    "grants": [
        // server-s1 / server-s2 へのフルアクセス - owner / CI / nanai10a
        {
            "src": ["autogroup:owner", "tag:ci", "nanai10a@github"],
            "dst": ["tag:server-s1", "tag:server-s2"],
            "ip":  ["*"],
        },
        // member - 任意の Exit Node 経由でインターネット
        {
            "src": ["autogroup:member"],
            "dst": ["autogroup:internet"],
            "ip":  ["*"],
        },
        // kimchi5005 (shared user) - Exit Node 利用のみ
        // 前提: server-s1 を machine share し "Allow use as an exit node" を有効化
        // 共有しているのは server-s1 だけなので，経由できる Exit Node は実質 server-s1 のみ
        {
            "src": ["kimchi5005@github"],
            "dst": ["autogroup:internet"],
            "ip":  ["*"],
        },
        // k3s ノード間通信 (s1 agent <-> s2 server) - 必要なポートのみ
        // 6443/tcp: apiserver (agent -> server の join / 通信)
        // 10250/tcp: kubelet (server -> agent の logs / exec)
        // 8472/udp: flannel vxlan (Pod 間通信)
        // 双方向の新規接続が発生するため，src / dst を両方向に許可している
        {
            "src": ["tag:server-s1", "tag:server-s2"],
            "dst": ["tag:server-s1", "tag:server-s2"],
            "ip":  ["tcp:6443", "tcp:10250", "udp:8472"],
        },
        // Prometheus (s2) が s1 の node-exporter をスクレイプする
        // 9100/tcp: node-exporter (hostNetwork)．s2 -> s1 の一方向のみで，逆向きは不要
        {
            "src": ["tag:server-s2"],
            "dst": ["tag:server-s1"],
            "ip":  ["tcp:9100"],
        },
    ],

    // ===== Tailscale SSH Declaration =====
    // kimchi5005 は意図的に含めない（足さなければ SSH は塞がれたまま）
    "ssh": [
        {
            "action": "accept",
            "src":    ["autogroup:owner", "tag:ci"],
            "dst":    ["tag:server-s1", "tag:server-s2"],
            "users":  ["m1sk9"],
        },
        {
            "action": "accept",
            "src":    ["nanai10a@github"],
            "dst":    ["tag:server-s1", "tag:server-s2"],
            "users":  ["nanai"],
        },
    ],

    // ===== Node Attributes (Funnel / NextDNS) =====
    "nodeAttrs": [
        {
            "target": ["m1sk9@github", "tag:server-s1", "tag:server-s2"],
            "attr":   ["nextdns:${NEXTDNS_PROFILE_ID}"],
        },
        {
            "target": ["*"],
            "attr":   ["nextdns:no-device-info"],
        },
    ],
}
