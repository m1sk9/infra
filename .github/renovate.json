{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>m1sk9/renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Actions run with the deploy credentials, so an upstream release must not reach main without review",
      "matchManagers": ["github-actions"],
      "automerge": false
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^k8s/apps/[^/]+/templates/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/roles/restic_backup/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "restic_version:\\s*\"(?<currentValue>.*?)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "restic/restic",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
