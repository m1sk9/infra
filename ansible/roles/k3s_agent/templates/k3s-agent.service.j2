# Managed by Ansible (role k3s_agent). Mirrors the unit the upstream installer writes.
[Unit]
Description=Lightweight Kubernetes (agent)
Documentation=https://k3s.io
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
EnvironmentFile=-/etc/default/%N
EnvironmentFile=-/etc/sysconfig/%N
EnvironmentFile=-/etc/systemd/system/%N.service.env
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
# After= alone is not enough: tailscaled reports ready before tailscale0 has its
# address, and flannel (flannel-iface: tailscale0) then exits with k3s.
ExecStartPre=/usr/bin/timeout 60 /bin/sh -c 'until ip -4 -o addr show dev tailscale0 2>/dev/null | grep -q inet; do sleep 1; done'
ExecStart=/usr/local/bin/k3s agent
